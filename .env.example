# PitchPulse local environment template.
# Copy to .env.local and fill values. .env.local is gitignored.

# ── AWS sandbox profile (the ISB portal regenerates this name each refresh) ──
# When you refresh credentials, only this name changes — the rest of the repo
# reads from here, so updates are 1-line.
AWS_PROFILE_NAME=058755927272_slalom_IsbUsersPS
AWS_REGION=eu-central-1
AWS_ACCOUNT_ID=058755927272

# ── Hackathon data source (read-only; sim Lambda will GetObject this in Gate 4) ──
HACKATHON_DATA_BUCKET=hackathon-data-058755927272
MATCH_EVENTS_KEY=Challenge 3 – A Real Time Social Match Experience/data/Match-Events/Events_Anonym.xml
MATCH_INFO_KEY=Challenge 3 – A Real Time Social Match Experience/data/Match-Events/MatchInformations_Anonym.xml

# ── Frontend: filled by CDK outputs after Gate 4 deploy ──
VITE_APPSYNC_URL=
VITE_APPSYNC_REGION=eu-central-1
VITE_COGNITO_IDENTITY_POOL_ID=

# ── Local sim tuning (Gate 1) ──
# 1 match-minute = N real seconds. 2 = full match plays in ~3 minutes (demo cadence).
VITE_SIM_SECONDS_PER_MATCH_MINUTE=2

# ── Prompt window (Gate 2) ──
# Server-side voting window in WALL milliseconds. Spec target: 30000 (30 sec).
# Lower this to 12000–15000 if recording a tight demo video — keeps vote windows
# short so multiple prompts fit in a 3-min match playback. NEVER set below 5000
# (humans can't react in time).
VITE_PROMPT_WINDOW_MS=30000
