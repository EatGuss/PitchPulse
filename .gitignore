# ─── PitchPulse / hackathon-specific ──────────────────────────────────────────
# DFL hackathon source data — NEVER commit (Challenge 3 brief, Section 10).
# Pulled locally from s3://hackathon-data-058755927272 for offline development.
# Path-anchored (leading slash) so it does NOT match src/data/ (which IS source).
/data/

# Derived match data — generated by `npm run parse` from /data/*.xml.
# Still hackathon-derived content; treat like source data per Section 10.
/public/events.json
/public/match-info.json

# AWS CDK synth output
/cdk.out/
cdk.out/
*.cdk.staging/

# AWS CDK deploy outputs — contains AppSync API key + Identity Pool ID.
# Anything beyond endpoint URLs is sandbox-scoped and tied to temp creds, but
# treat as secret. Re-generate via `cdk deploy --outputs-file cdk-outputs.json`.
/cdk/cdk-outputs.json
cdk/cdk-outputs.json

# Local Lambda invocation fixtures (created by `aws lambda invoke`).
/cdk/start-match-payload.json
/cdk/start-match-response.json
cdk/start-match-payload.json
cdk/start-match-response.json
cdk/out.json

# AWS SAM build artifacts (in case of future use)
.aws-sam/

# Local env files (the .env.* rule above already covers these but kept explicit)
.env.local
.env.*.local

# Defensive: never commit AWS creds even if accidentally placed in repo
*.pem
.aws/

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/

# Build / packaging output for submission
/submission/*.zip

