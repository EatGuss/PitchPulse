{
  "//": "Type-checks the Lambda sources, which cdk/tsconfig.json excludes. Run: npm run typecheck:lambda",
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node", "aws-lambda"]
  },
  "include": ["**/*.ts", "../test/**/*.ts"]
}
